# Clerk authentication — get these from https://dashboard.clerk.com
# (Create an application, then copy both keys from "API Keys")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Axon backend (n8n on Railway)
AXON_API_URL=https://axon-n8n-production-1512.up.railway.app

# Must match the AXON_SIGNUP_SECRET variable on the Railway n8n service.
# Server-side only — never expose with a NEXT_PUBLIC_ prefix.
AXON_SIGNUP_SECRET=xxxxxxxxxxxxxxxx

# Enterprise contact form email delivery (Gmail SMTP).
# GMAIL_APP_PASSWORD is a Google "App Password" (requires 2-Step Verification
# on the account), NOT the normal Gmail password. Server-side only.
GMAIL_USER=axonapiai2026@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
CONTACT_SALES_TO=axonapiai2026@gmail.com

# Razorpay (test mode first: rzp_test_ keys). KEY_ID is public; the other
# values are server-side secrets. WEBHOOK_SECRET is a random string you invent
# and paste identically into the Razorpay dashboard webhook settings.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

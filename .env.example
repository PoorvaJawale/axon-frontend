# Clerk authentication — get these from https://dashboard.clerk.com
# (Create an application, then copy both keys from "API Keys")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Server-only PostgreSQL role. Run reviewed migrations/grants before using this build.
# Verify the certificate chain and hostname; never use sslmode=no-verify.
AXON_DATABASE_URL=postgresql://axon_control:REPLACE@YOUR_DB_HOST:5432/axon?sslmode=verify-full

# Optional trusted PostgreSQL CA certificate as PEM; server-only.
# AXON_DATABASE_CA=-----BEGIN CERTIFICATE-----...

# Enterprise contact form email delivery (Gmail SMTP).
# GMAIL_APP_PASSWORD is a Google "App Password" (requires 2-Step Verification
# on the account), NOT the normal Gmail password. Server-side only.
GMAIL_USER=your-smtp-login@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
CONTACT_SALES_TO=axonapi2026@gmail.com

# Razorpay (test mode first: rzp_test_ keys). KEY_ID is public; the other
# values are server-side secrets. WEBHOOK_SECRET is a random string you invent
# and paste identically into the Razorpay dashboard webhook settings.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Monthly INR plan: amount 79900 paise (₹799), period monthly, interval 1.
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# On-demand Status page checks. Server-side only; never use NEXT_PUBLIC_ names.
# Production: your public Vercel/custom-domain URL. Local: http://localhost:3000
AXON_PUBLIC_SITE_URL=https://axon-frontend-vxa8.vercel.app
# Activate the separate Axon Health workflow described in docs/status-monitoring.md.
AXON_HEALTHCHECK_URL=https://n8n-production-a160e.up.railway.app/webhook/axon-health
AXON_HEALTHCHECK_SECRET=replace-with-a-new-random-secret

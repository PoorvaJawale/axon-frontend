    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst rawKey = $json.raw_api_key;\n\nconst hashedKey =\n  crypto\n    .createHash('sha256')\n    .update(rawKey)\n    .digest('hex');\n\nconst webhookSecret =\n  crypto\n    .randomBytes(32)\n    .toString('hex');\n\nreturn [{\n  json: {\n    ...$json,\n    hashed_api_key: hashedKey,\n    webhook_secret: webhookSecret\n  }\n}];"
      },

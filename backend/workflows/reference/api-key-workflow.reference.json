    {
      "parameters": {
        "jsCode": "const plan = ($json.body && $json.body.plan) || 'free';\n\nlet limit;\nif (plan === 'enterprise') {\n  limit = 999999999;\n} else if (plan === 'pro') {\n  limit = 5000;\n} else {\n  limit = 100;\n}\n\nreturn [{\n  json: {\n    ...$json,\n    plan,\n    request_limit: limit\n  }\n}];"
      },

    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst auth = ($json.headers && $json.headers.authorization) || '';\nconst rawKey = auth.replace('Bearer ', '').trim();\n\nconst hashedKey = crypto\n  .createHash('sha256')\n  .update(rawKey)\n  .digest('hex');\n\nreturn [{\n  json: {\n    ...$json,\n    hashed_key: hashedKey\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "f2c959d2-5a5d-5d67-9b7d-f8a387da5f1d",
      "name": "Code in JavaScript1",
      "retryOnFail": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *\nFROM api_keys\nWHERE hashed_api_key = $1\nAND is_active = true\nAND expires_at > NOW();",
        "options": {
          "queryReplacement": "={{$json.hashed_key}}"
        }
      },
      "type": "n8n-nodes-base.postgres",

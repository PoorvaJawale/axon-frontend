      "id": "14ba23a6-5f6c-fbd2-a1e0-1d9898619320",
      "name": "Code in JavaScript",
      "retryOnFail": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH usage AS (\n  SELECT\n    k.user_id,\n    a.plan,\n    k.expires_at,\n    CASE\n      WHEN a.plan = 'free' THEN a.free_used\n      ELSE a.paid_used\n    END AS used,\n    CASE a.plan\n      WHEN 'free' THEN 100\n      WHEN 'pro' THEN 5000\n      ELSE a.custom_limit\n    END AS quota,\n    a.period_start,\n    a.period_end,\n    (\n      a.plan = 'free'\n      OR (\n        now() >= a.period_start\n        AND now() < a.period_end\n      )\n    ) AS period_active\n  FROM public.api_keys k\n  JOIN public.axon_account_quota a\n    ON a.user_id = k.user_id\n  WHERE k.hashed_api_key = $1\n    AND k.is_active = true\n    AND k.expires_at > now()\n)\nSELECT\n  user_id,\n  plan,\n  used AS monthly_requests,\n  quota AS request_limit,\n  CASE\n    WHEN period_active THEN GREATEST(quota - used, 0)\n    ELSE 0\n  END AS remaining,\n  expires_at,\n  period_start,\n  period_end,\n  COALESCE(period_active, false) AS period_active,\n  CASE\n    WHEN plan = 'free' THEN 'lifetime'\n    ELSE 'billing_period'\n  END AS quota_period\nFROM usage;",
        "options": {
          "queryReplacement": "={{ [ $node[\"Code in JavaScript1\"].json.hashed_key ] }}"
        }
      },

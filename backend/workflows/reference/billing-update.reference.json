      "id": "c8d17502-f147-b295-26c2-6797673bc1ac",
      "name": "Webhook",
      "webhookId": "b9f1c2d3-0001-4000-8000-000000000001",
      "retryOnFail": false
    },
    {
      "parameters": {
        "jsCode": "const secret = $env.AXON_SIGNUP_SECRET || \"\";\nconst body = $json.body || {};\nconst supplied = String(\n  ($json.headers || {})[\"x-axon-signup-secret\"] || \"\"\n);\n\nconst plan = body.plan;\nconst paid = plan === \"pro\" || plan === \"enterprise\";\n\nconst validTimestamp = value =>\n  typeof value === \"number\" &&\n  Number.isSafeInteger(value) &&\n  value > 0 &&\n  value <= 253402300799;\n\nconst periodOK =\n  !paid ||\n  (\n    validTimestamp(body.period_start) &&\n    validTimestamp(body.period_end) &&\n    body.period_end > body.period_start\n  );\n\nconst customLimitOK =\n  plan !== \"enterprise\" ||\n  (\n    Number.isSafeInteger(body.enterprise_limit) &&\n    body.enterprise_limit > 0\n  );\n\nconst authorized =\n  secret !== \"\" &&\n  supplied === secret &&\n  typeof body.user_id === \"string\" &&\n  body.user_id.length > 0 &&\n  [\"free\", \"pro\", \"enterprise\"].includes(plan) &&\n  validTimestamp(body.occurred_at) &&\n  body.occurred_at <= Math.floor(Date.now() / 1000) + 300 &&\n  periodOK &&\n  customLimitOK;\n\nreturn [{\n  json: {\n    authorized,\n    user_id: body.user_id,\n    plan,\n    request_limit:\n      plan === \"free\" ? 100 :\n      plan === \"pro\" ? 5000 :\n      body.enterprise_limit,\n    period_start:\n      paid && periodOK\n        ? new Date(body.period_start * 1000).toISOString()\n        : null,\n    period_end:\n      paid && periodOK\n        ? new Date(body.period_end * 1000).toISOString()\n        : null,\n    occurred_at:\n      validTimestamp(body.occurred_at)\n        ? new Date(body.occurred_at * 1000).toISOString()\n        : null,\n    enterprise_limit:\n      plan === \"enterprise\" && customLimitOK\n        ? body.enterprise_limit\n        : 0\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        80
      ],
      "id": "ac98129d-132f-e030-ec45-610c8b14e221",
      "name": "Auth Gate",
      "retryOnFail": false
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "a1b2c3d4-0003-4000-8000-000000000003",
              "leftValue": "={{$json.authorized}}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [

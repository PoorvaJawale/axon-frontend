    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.axon_apply_billing(\n  $1,\n  $2,\n  $3::timestamptz,\n  $4::timestamptz,\n  $5::timestamptz,\n  $6::bigint\n) AS data;",
        "options": {
          "queryReplacement": "={{ [\n  $json.user_id,\n  $json.plan,\n  $json.period_start,\n  $json.period_end,\n  $json.occurred_at,\n  $json.enterprise_limit\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",

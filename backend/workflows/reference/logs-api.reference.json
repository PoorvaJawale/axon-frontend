      "parameters": {
        "jsCode": "const query = $node[\"Webhook\"].json.query || {};\n\nconst page = parseInt(query.page || 1);\nconst limit = Math.min(parseInt(query.limit || 50), 200);\nconst offset = (page - 1) * limit;\n\nreturn [{\n  json: {\n    ...$json,\n    page,\n    limit,\n    offset\n  }\n}];"

      "parameters": {
        "jsCode": "const secret = $env.AXON_SIGNUP_SECRET || '';\nconst headers = $json.headers || {};\nconst given = (headers['x-axon-signup-secret'] || '').toString();\nconst body = $json.body || {};\n\nconst keyId = Number(body.key_id);\n\nconst authorized =\n  secret !== '' &&\n  given === secret &&\n  typeof body.user_id === 'string' &&\n  body.user_id.length > 0 &&\n  Number.isFinite(keyId) &&\n  keyId > 0;\n\nreturn [{\n  json: {\n    authorized,\n    user_id: body.user_id,\n    key_id: keyId\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        80
      ],

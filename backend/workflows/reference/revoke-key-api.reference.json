        "operation": "executeQuery",
        "query": "UPDATE api_keys\nSET is_active = false,\n    updated_at = NOW()\nWHERE id = $2\nAND user_id = $1\nRETURNING id, key_prefix, name;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.key_id] }}"
        }

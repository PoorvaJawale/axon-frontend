{
  "name": "axon-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "next build --webpack",
    "prebuild": "node scripts/provider-preflight.cjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "backend:generate": "node backend/n8n/build-workflows.cjs",
    "backend:check": "node scripts/check-workflows.cjs",
    "launch:preflight": "node scripts/preflight.cjs",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.23",
    "@clerk/themes": "^2.4.57",
    "geist": "^1.9.0",
    "lucide-react": "^1.17.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
